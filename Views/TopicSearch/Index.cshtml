@model TopicSearchViewModel;
@using Microsoft.AspNetCore.WebUtilities

@section Head {
  <link rel="stylesheet" type="text/css" href="/Shared/Styles/Views/Form.css" asp-append-version="true" />
}

<div id="TopicSearch">

  <!-- Form -->
  <section class="panel">

    @if (Model.Query is not null) {
      var instanceCount = Model.Results.Values.Sum(results => results.Count);
      <div style="margin-top: -2rem;">
        @if (Model.Errors.Count > 0) {
          @foreach(var error in Model.Errors) {
            <blockquote class="stop">
              @error
            </blockquote>
          }
        }
        else
          switch (Model.Action) {
            case TopicSearchAction.Search when Model.Results.Count is 0:
              <blockquote class="stop">
                No results were found for the search query.
              </blockquote>
              break;
            case TopicSearchAction.Search:
              <blockquote class="success">
                @pluralize("instance", instanceCount) @(instanceCount is 1? "was" : "were") found across @pluralize("topic", Model.Results.Count) for the search query.
              </blockquote>
              break;
            case TopicSearchAction.ReplacePreview:
              <blockquote class="stop">
                @pluralize("instance", instanceCount) across @pluralize("topic", Model.Results.Count) will be updated with the replacement expression. If the results look right, click "Replace" again to confirm.
              </blockquote>
              break;
            case TopicSearchAction.ReplaceConfirm:
              <blockquote class="success">
                @pluralize("instance", instanceCount) across @pluralize("topic", Model.Results.Count) @(instanceCount is 1? "was" : "were") successfully updated with the replacement expression.
              </blockquote>
              break;
            default:
              throw new ArgumentOutOfRangeException(Model.Action.ToString());
          }
  </div>
    }

    @{
      var isConfirming = Model.Action is TopicSearchAction.ReplacePreview && Model.Query is not null;
    }

    <form id="SearchResultSearchForm" action="/TopicSearch/">

      <label class="form-field">
        <div class="input-group">
          <span class="input-group-label">https://www.goldsim.com/</span>
          <input class="input-group-field" type="text" id="Scope" name="Scope" value="@Model.Scope" pattern="^[A-Za-z0-9_\-\/]*$" @(isConfirming ? "disabled" : "") />
        </div>
      </label>

      <label class="form-field">
        Query
        <input type="search" name="Query" value="@Model.Query" @(isConfirming ? "disabled" : "") />
      </label>

      @if (Model.Query is not null) {
        <label class="form-field">
          Replacement Expression
          <input type="text" name="Replace" value="@Model.Replace" @(isConfirming || Model.Action is TopicSearchAction.ReplaceConfirm? "disabled" : "") />
        </label>
      }

      <div class="options">
        <div class="checkbox">
          <input type="checkbox" id="IsRegularExpression" name="IsRegularExpression" value="true" @(Model.IsRegularExpression ? "checked" : "") @(isConfirming ? "disabled" : "")>
          <label for="IsRegularExpression">Use <a href="https://learn.microsoft.com/en-us/dotnet/standard/base-types/regular-expression-language-quick-reference">regular expressions</a>.</label>
        </div>
        <div class="checkbox">
          <input type="checkbox" id="IsCaseSensitive" name="IsCaseSensitive" value="true" @(Model.IsCaseSensitive ? "checked" : "") @(isConfirming ? "disabled" : "")>
          <label for="IsCaseSensitive">Case sensitive.</label>
        </div>
      </div>

      @if (isConfirming) {
        <a class="button large secondary" href="@cancelUrl()">Cancel</a>
      }
      else {
        <button class="button primary large" type="submit" name="Action" value="Search">Search</button>
      }

      @if (Model.Action is TopicSearchAction.Search && Model.Query is not null) {
        <button class="button primary large success" type="submit" name="Action" value="ReplacePreview" @(Model.Results.Count is 0 ? "disabled" : "")>Replace</button>
      }

      @if (isConfirming) {
        <button class="button primary large alert" type="submit" form="ReplaceConfirmForm" @(Model.Results.Count is 0 ? "disabled" : "")>Replace</button>
      }

    </form>

    <!-- Confirm replacement (POST, to confirm exactly what was previewed) -->
    @if (isConfirming) {
      <form id="ReplaceConfirmForm" method="post" action="/TopicSearch/">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Scope" value="@Model.Scope" />
        <input type="hidden" name="Query" value="@Model.Query" />
        <input type="hidden" name="Replace" value="@Model.Replace" />
        <input type="hidden" name="IsRegularExpression" value="@Model.IsRegularExpression.ToString().ToLowerInvariant()" />
        <input type="hidden" name="IsCaseSensitive" value="@Model.IsCaseSensitive.ToString().ToLowerInvariant()" />
      </form>
    }

  </section>

  <p />

  <!-- Results -->
  @if (Model.Results.Count > 0) {
    <section class="panel">
      <div id="SearchResults">
        <h1>Results</h1>
        <ul>
        @foreach (var topic in Model.Results.Keys) {
          var path = String.IsNullOrEmpty(Model.Scope)? topic.WebPath : topic.WebPath.Replace(Model.Scope, "").Replace("//", "/");
          var lastSegmentIndex = path.TrimEnd('/').LastIndexOf('/') + 1;
          <li>
            <a class="result-path" href="/OnTopic/Edit/@topic.WebPath" title="@topic.WebPath"><span class="result-path-start">@path[..lastSegmentIndex]</span><span class="result-path-end">@path[lastSegmentIndex..]</span></a>
            @if (!Model.IsRegularExpression) {
              var attributes = Model.Results[topic].GroupBy(t => t.AttributeKey).Select(g => new { g.Key, Count = g.Count()}).OrderBy(x => x.Count).ToList();
              if (attributes.Count is 1) {
                <span>(@(pluralize("instance", attributes.First().Count)) in <strong>@attributes.First().Key</strong>)</span>
              }
              else {
                <span>(@(pluralize("instance", Model.Results[topic].Count)) in @(pluralize("attribute", attributes.Count)))</span>
                <ul>
                  @foreach (var attribute in attributes) {
                    <li><strong>@(attribute.Key):</strong> @(pluralize("instance", attribute.Count))</li>
                  }
                </ul>
              }
            }
            else {
              <ul>
                @foreach (var match in Model.Results[topic]) {
                  if (Model.Action is TopicSearchAction.Search) {
                    <li><strong>@(match.AttributeKey):</strong> @match.Match</li>
                  }
                  else {
                    <li><strong>@(match.AttributeKey):</strong> <del>@match.Match</del> <ins>@match.RelaceResult</ins></li>
                  }
                }
              </ul>
            }
          </li>
        }
        </ul>
      </div>
    </section>
  }

</div>

@section CallsToActionSection {}

@{
  string pluralize(string label, int count) => count + " " + label + (count > 1? "s" : "");

  // Returns to the search results for the current query, without replacing anything
  string cancelUrl() => QueryHelpers.AddQueryString(
    "/TopicSearch/",
    new Dictionary<string, string> {
      { "Scope", Model.Scope ?? "" },
      { "Query", Model.Query },
      { "IsRegularExpression", Model.IsRegularExpression.ToString().ToLowerInvariant() },
      { "IsCaseSensitive", Model.IsCaseSensitive.ToString().ToLowerInvariant() },
      { "Action", "Search" }
    }
  );
}

<!--
  Controller: TopicSearch
  Action: Search
  View Location: ~/Views/TopicSearch/Index.cshtml
-->