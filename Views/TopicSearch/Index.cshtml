@model TopicSearchViewModel;

<div>

  <!-- Form -->
  <section class="panel">
    <p>Search for terms that appear in topics. If the term appears in any attribute in the topic, that topic will be returned below. Supports <a href="https://learn.microsoft.com/en-us/dotnet/standard/base-types/regular-expression-language-quick-reference">Regular Expressions</a>.</p>
    <form id="SearchResultSearchForm" action="/TopicSearch/">
      <input type="search" id="Query" name="Query" value="@Model.Query" />
      @if (Model.Action is TopicSearchAction.Search && Model.Query is not null) {
        <input type="text" id="Replace" name="ReplacePreview" value="@Model.Replace" />
      }
      <input class="button primary large" type="submit" name="Search" value="Search" />
      @if (Model.Action is TopicSearchAction.Search && Model.Query is not null) {
        <input class="button primary large suc" type="submit" name="ReplaceConfirm" value="Replace" />
      }
      @if (Model.Action is TopicSearchAction.ReplacePreview && Model.Query is not null) {
        <input class="button primary large alert" type="submit" name="ReplaceConfirm" value="Replace" />
      }
    </form>
  </section>

  <p />

  @if (Model.Action is TopicSearchAction.ReplacePreview) {
    <blockquote class="stop">
      @Model.Results.Count topics will be updated with the replacement expression. If the results look right, click "Replace" again to confirm.
    </blockquote>
  }
  @if (Model.Action is TopicSearchAction.ReplaceConfirm) {
    <blockquote class="note">
      @Model.Results.Count topics were successfully updated with the replacement expression.  
    </blockquote>
  }

  <!-- Results -->
  @if (Model.Results.Count > 0) {
    <section class="panel">
      <div id="SearchResults">
        <h1>Results</h1>
        <ul>
        @foreach (var topic in @Model.Results) {
          <li><a href="/OnTopic/Edit/@topic.WebPath">@topic.Title</a></li>
        }
        </ul>
      </div>
    </section>
  }

</div>

@section CallsToActionSection {}

<!--
  Controller: TopicSearch
  Action: Search
  View Location: ~/Views/TopicSearch/Index.cshtml
-->