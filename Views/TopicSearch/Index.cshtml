@model TopicSearchViewModel;

@section Head {
  <link rel="stylesheet" type="text/css" href="/Shared/Styles/Views/Form.css" asp-append-version="true" />
}

<div>

  <!-- Form -->
  <section class="panel">

    <form id="SearchResultSearchForm" action="/TopicSearch/">

      <label class="form-field">
        <div class="input-group">
          <span class="input-group-label">https://www.goldsim.com/</span>
          <input class="input-group-field" type="text" id="Scope" name="Scope" value="@Model.Scope" pattern="^[A-Za-z0-9_\-\/]*$" />
        </div>
      </label>

      <label class="form-field">
        Query
        <input type="search" name="Query" value="@Model.Query" />
      </label>

      @if (Model.Query is not null) {
        <label class="form-field">
          Replacement Expression
          <input type="text" name="Replace" value="@Model.Replace" @(Model.Action is TopicSearchAction.ReplaceConfirm? "disabled" : "") />
        </label>
      }

      <div class="checkbox">
        <input type="checkbox" id="UseRegEx" name="UseRegEx" value="true" @(Model.UseRegEx ? "checked" : "")>
        <label for="UseRegEx">Use <a href="https://learn.microsoft.com/en-us/dotnet/standard/base-types/regular-expression-language-quick-reference">regular expressions</a>.</label>
      </div>

      <button class="button primary large" type="submit" name="Action" value="Search">Search</button>

      @if (Model.Action is TopicSearchAction.Search && Model.Query is not null) {
        <button class="button primary large success" type="submit" name="Action" value="ReplacePreview" @(Model.Results.Count is 0 ? "disabled" : "")>Replace</button>
      }

      @if (Model.Action is TopicSearchAction.ReplacePreview && Model.Query is not null) {
        <button class="button primary large alert" type="submit" name="Action" value="ReplaceConfirm" @(Model.Results.Count is 0 ? "disabled" : "")>Replace</button>
      }

    </form>

    @if (Model.Action is TopicSearchAction.Search && Model.Query is not null) {
      if (Model.Results.Count is 0) {
        <blockquote class="stop">
          No results were found for the search query.
        </blockquote>
      }
      else {
        <blockquote class="note">
          @Model.Results.Count topics were found for the search query.
        </blockquote>
      }
    }
    else if (Model.Action is TopicSearchAction.ReplacePreview) {
      <blockquote class="stop">
        @Model.Results.Count topics will be updated with the replacement expression. If the results look right, click "Replace" again to confirm.
      </blockquote>
    }
    else if (Model.Action is TopicSearchAction.ReplaceConfirm) {
      <blockquote class="note">
        @Model.Results.Count topics were successfully updated with the replacement expression.
      </blockquote>
    }

  </section>

  <p />

  <!-- Results -->
  @if (Model.Results.Count > 0) {
    <section class="panel">
      <div id="SearchResults">
        <h1>Results</h1>
        <ul>
        @foreach (var topic in @Model.Results.Keys) {
          <li>
            <ul>
              @foreach (var match in @Model.Results[topic]) {
                @if (Model.Action is TopicSearchAction.Search) {
                  <li><strong>@(match.AttributeKey):</strong> @match.Match </li>
                }
                else {
                  <li><strong>@(match.AttributeKey):</strong> <s>@match.Match</s> @match.RelaceResult</li>
                }
            <a href="/OnTopic/Edit/@topic.WebPath">@topic.WebPath</a>
              }
            </ul>
          </li>
        }
        </ul>
      </div>
    </section>
  }

</div>

@section CallsToActionSection {}

<!--
  Controller: TopicSearch
  Action: Search
  View Location: ~/Views/TopicSearch/Index.cshtml
-->