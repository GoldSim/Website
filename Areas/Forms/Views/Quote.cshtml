@model FormPageTopicViewModel<QuoteFormBindingModel>

@section PageBodySection {

  <fieldset>
    <legend>Product Selection</legend>
    <div class="grid-x grid-margin-x">

      <div class="cell"><p>Multiple license purchases may be subject to volume discounts.</p></div>
      <partial name="_ProductSelection" for="BindingModel" />

      @Html.EditorFor(model => model.BindingModel.Instructions, "TextArea", new { cssClass = "" })

    </div>
  </fieldset>

  <fieldset>
    <legend>Buyer Contact Information</legend>
    <div class="grid-x grid-margin-x">

      @Html.EditorFor(model => model.BindingModel.FirstName)
      @Html.EditorFor(model => model.BindingModel.LastName)

      @Html.EditorFor(model => model.BindingModel.Organization)

      @Html.EditorFor(model => model.BindingModel.PhoneNumber, "String")
      @Html.EditorFor(model => model.BindingModel.FaxNumber, "String")

      @Html.EditorFor(model => model.BindingModel.Email, "String")
      @Html.EditorFor(model => model.BindingModel.Country, "Select")

      <partial name="_Address" for="BindingModel.Address" />

    </div>
  </fieldset>

}

@section Scripts {
  @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}