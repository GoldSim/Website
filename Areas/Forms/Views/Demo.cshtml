@model FormPageTopicViewModel<DemoFormBindingModel>

@section PageBodySection {

  <fieldset>
    <div class="grid-x grid-margin-x">

      @Html.EditorFor(model => model.BindingModel.FirstName)
      @Html.EditorFor(model => model.BindingModel.LastName)

      @Html.EditorFor(model => model.BindingModel.Organization)
      @Html.EditorFor(model => model.BindingModel.JobTitle)

      @Html.EditorFor(model => model.BindingModel.Email, "String")
      @Html.EditorFor(model => model.BindingModel.PhoneNumber, "String")
      <partial name="_EmailInstructions" />

      @Html.EditorFor(model => model.BindingModel.Country, "Select")
      @Html.EditorFor(model => model.BindingModel.Province, "Select", new { cssClass = "medium-6 state-lookup is-hidden" })
      @Html.EditorFor(model => model.BindingModel.Province, new { cssClass = "medium-6 province-input" })
      <partial name="_Requirements" for="BindingModel" />

      @Html.EditorFor(model => model.BindingModel.OtherTools, "TextArea")

      <partial name="_Referral" for="BindingModel" />

    </div>
  </fieldset>

}